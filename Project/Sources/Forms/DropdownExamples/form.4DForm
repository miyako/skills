{
  "$4d": {
    "version": "1",
    "kind": "form"
  },
  "windowSizingX": "variable",
  "windowSizingY": "variable",
  "windowMinWidth": 400,
  "windowMinHeight": 300,
  "windowMaxWidth": 32767,
  "windowMaxHeight": 32767,
  "rightMargin": 20,
  "bottomMargin": 20,
  "events": ["onLoad", "onUnload"],
  "windowTitle": "Dropdown List Showcase",
  "destination": "detailScreen",
  "method": "method.4dm",
  "pages": [
    { "objects": {} },
    {
      "objects": {
        "lblTitle": {
          "type": "text",
          "top": 20,
          "left": 20,
          "width": 660,
          "height": 24,
          "text": "4D Dropdown Showcase: Object, Array, and Choice List",
          "fontWeight": "bold",
          "fontSize": 16
        },
        "lblObjectSection": {
          "type": "text",
          "top": 60,
          "left": 20,
          "width": 450,
          "height": 18,
          "text": "1. Object-based Dropdown (Modern & Recommended)",
          "fontWeight": "bold"
        },
        "lblObjectDesc": {
          "type": "text",
          "top": 80,
          "left": 20,
          "width": 660,
          "height": 16,
          "text": "DataSource: Form.dropObject (Collection with 5 items, index: -1, currentValue: placeholder)",
          "fontSize": 11
        },
        "dropObject": {
          "type": "dropdown",
          "top": 105,
          "left": 20,
          "width": 280,
          "height": 22,
          "dataSource": "Form.dropObject",
          "dataSourceTypeHint": "object",
          "events": ["onClick", "onDataChange"],
          "method": "ObjectMethods/dropObject.4dm"
        },
        "btnGetObject": {
          "type": "button",
          "top": 105,
          "left": 310,
          "width": 110,
          "height": 22,
          "text": "Get Value",
          "events": ["onClick"],
          "method": "ObjectMethods/btnGetObject.4dm"
        },
        "lblObjectResult": {
          "type": "text",
          "top": 108,
          "left": 430,
          "width": 60,
          "height": 18,
          "text": "Chosen:"
        },
        "inputObjectResult": {
          "type": "input",
          "top": 105,
          "left": 490,
          "width": 190,
          "height": 22,
          "dataSource": "Form.objectResult",
          "dataSourceTypeHint": "text",
          "enterable": false
        },
        "lblArraySection": {
          "type": "text",
          "top": 150,
          "left": 20,
          "width": 450,
          "height": 18,
          "text": "2. Array-based Dropdown (Classic 4D Array)",
          "fontWeight": "bold"
        },
        "lblArrayDesc": {
          "type": "text",
          "top": 170,
          "left": 20,
          "width": 660,
          "height": 16,
          "text": "DataSource: asArrayChoices (1-based array, element {0} is placeholder, value is asArrayChoices{asArrayChoices})",
          "fontSize": 11
        },
        "dropArray": {
          "type": "dropdown",
          "top": 195,
          "left": 20,
          "width": 280,
          "height": 22,
          "dataSource": "asArrayChoices",
          "dataSourceTypeHint": "arrayText",
          "events": ["onClick", "onDataChange"],
          "method": "ObjectMethods/dropArray.4dm"
        },
        "btnGetArray": {
          "type": "button",
          "top": 195,
          "left": 310,
          "width": 110,
          "height": 22,
          "text": "Get Value",
          "events": ["onClick"],
          "method": "ObjectMethods/btnGetArray.4dm"
        },
        "lblArrayResult": {
          "type": "text",
          "top": 198,
          "left": 430,
          "width": 60,
          "height": 18,
          "text": "Chosen:"
        },
        "inputArrayResult": {
          "type": "input",
          "top": 195,
          "left": 490,
          "width": 190,
          "height": 22,
          "dataSource": "Form.arrayResult",
          "dataSourceTypeHint": "text",
          "enterable": false
        },
        "lblListSection": {
          "type": "text",
          "top": 240,
          "left": 20,
          "width": 450,
          "height": 18,
          "text": "3. Choice List Dropdown (Static List saved as value)",
          "fontWeight": "bold"
        },
        "lblListDesc": {
          "type": "text",
          "top": 260,
          "left": 20,
          "width": 660,
          "height": 16,
          "text": "DataSource: Form.dropList (Inlined choiceList: 5 items, saveAs: value, initialized to placeholder text)",
          "fontSize": 11
        },
        "dropList": {
          "type": "dropdown",
          "top": 285,
          "left": 20,
          "width": 280,
          "height": 22,
          "dataSource": "Form.dropList",
          "dataSourceTypeHint": "text",
          "choiceList": [
            "Option 1: Project Plan",
            "Option 2: Architecture Review",
            "Option 3: UI Implementation",
            "Option 4: Quality Assurance",
            "Option 5: Production Deployment"
          ],
          "saveAs": "value",
          "events": ["onClick", "onDataChange"],
          "method": "ObjectMethods/dropList.4dm"
        },
        "btnGetList": {
          "type": "button",
          "top": 285,
          "left": 310,
          "width": 110,
          "height": 22,
          "text": "Get Value",
          "events": ["onClick"],
          "method": "ObjectMethods/btnGetList.4dm"
        },
        "lblListResult": {
          "type": "text",
          "top": 288,
          "left": 430,
          "width": 60,
          "height": 18,
          "text": "Chosen:"
        },
        "inputListResult": {
          "type": "input",
          "top": 285,
          "left": 490,
          "width": 190,
          "height": 22,
          "dataSource": "Form.listResult",
          "dataSourceTypeHint": "text",
          "enterable": false
        },
        "btnClose": {
          "type": "button",
          "top": 335,
          "left": 290,
          "width": 120,
          "height": 26,
          "text": "Close",
          "action": "cancel"
        }
      }
    }
  ]
}
